DATABASE_URL=<database URL>
SECRET_KEY=<a long string >
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=< ALGORITHM >
UPLOAD_DIR=./media/uploads

# ── Forgot password / SMTP ─────────────────────────────────────────────────
SMTP_HOST=<e.g. smtp.gmail.com>
SMTP_PORT=587
SMTP_USERNAME=<smtp login / your email address>
SMTP_PASSWORD=<smtp password / app password>
SMTP_FROM_EMAIL=<sender email address, defaults to SMTP_USERNAME>
SMTP_FROM_NAME=AI-ShopKeeper
SMTP_USE_TLS=true
PASSWORD_RESET_CODE_EXPIRE_MINUTES=10